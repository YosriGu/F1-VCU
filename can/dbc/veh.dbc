CM_ "VEH-CAN, 1 Mbit/s, classic CAN, 11-bit IDs. DRAFT message set derived from the VCU CAN spec section 4.2. Every message is Verification DRAFT until agreed with the owning team and tested. ID ranges: spec section 4.1.";
CM_ BO_ 1 "Global fault broadcast. Sent immediately on a class A/B fault, then every 100 ms while a fault is active.";
CM_ SG_ 1 VCU_EMERG_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 1 VCU_EMERG_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 1 VCU_EMERG_Code "Fault code from the VCU fault table (to be allocated).";
CM_ SG_ 1 VCU_EMERG_Source "Fault source module (to be allocated).";
CM_ SG_ 1 VCU_EMERG_Param "Fault-specific parameter.";
CM_ BO_ 16 "AMS state. Class A. VCU timeout 60 ms = 3 x period. DRAFT payload: state code, AMS OK flag, fault flag word; to be agreed with the AMS team.";
CM_ SG_ 16 AMS_STATE_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 16 AMS_STATE_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 16 AMS_State "DRAFT value table; the AMS team owns the real state list.";
CM_ SG_ 16 AMS_OK "1 = AMS reports no fault. Fail-safe start value 0. Information only: the AMS opens the SDC in hardware.";
CM_ SG_ 16 AMS_FaultFlags "DRAFT bit allocation by the AMS team.";
CM_ BO_ 17 "Discharge and charge current limits. Class A. An invalid or timed-out DCL/CCL is treated as 0 A by the VCU.";
CM_ SG_ 17 AMS_LIM_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 17 AMS_LIM_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 17 AMS_DCL_A "Discharge current limit. Start value 0 A (fail-safe).";
CM_ SG_ 17 AMS_CCL_A "Charge current limit (also limits regen). Start value 0 A (fail-safe).";
CM_ BO_ 18 "Pack voltage, current and state of charge. Class B. Positive current = discharge (design choice, confirm with the AMS team).";
CM_ SG_ 18 AMS_PACK_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 18 AMS_PACK_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 18 AMS_Soc_pct "0.5 % per bit (same step as the Orion OBD2 SOC value).";
CM_ BO_ 19 "Minimum and maximum cell voltage and temperature. Class B, timeout 300 ms = 3 x period.";
CM_ SG_ 19 AMS_TEMPV_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 19 AMS_TEMPV_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ BO_ 31 "AMS heartbeat with error flags. Class B, timeout 300 ms.";
CM_ SG_ 31 AMS_HB_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 31 AMS_HB_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 31 AMS_HbCounter "Free-running counter, increments every transmission.";
CM_ BO_ 32 "VCU state broadcast, 10 ms. Information only.";
CM_ SG_ 32 VCU_STATE_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 32 VCU_STATE_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 32 VCU_StateMachine "State machine of the VCU design, section 5.3.";
CM_ SG_ 32 VCU_TorqueReqPct "Driver torque request after the pedal map.";
CM_ SG_ 32 VCU_TorqueLimPct "Torque limit after the limiter chain.";
CM_ SG_ 32 VCU_SDC_Sense "Read-only SDC node sensing (bit allocation to be defined in the ICD).";
CM_ BO_ 33 "VCU heartbeat, 100 ms: 32 error flags plus a free-running counter.";
CM_ SG_ 33 VCU_HB_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 33 VCU_HB_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ BO_ 34 "Traction-system power as seen by the VCU. Class B.";
CM_ SG_ 34 VCU_POWER_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 34 VCU_POWER_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 34 VCU_PwrLimState "Active limiter stage (DRAFT list).";
CM_ BO_ 35 "VCU software version and calibration CRC, 1 s.";
CM_ SG_ 35 VCU_VER_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 35 VCU_VER_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ BO_ 48 "Dashboard input, class C. Can only lower torque or power. No E2E header (DataId 0). VCU falls back to the default map after 250 ms.";
CM_ BO_ 257 "Telemetry 1: pedal and brake pressure. Information only.";
CM_ BO_ 258 "Telemetry 2: wheel speeds.";
CM_ BO_ 259 "Telemetry 3: IMU acceleration and yaw rate.";
CM_ BO_ 260 "Telemetry 4: roll and pitch rate, commanded and measured inverter current.";
CM_ SG_ 260 VCU_Tlm_MeasIq_A "Measured Iq from the inverter status. Source layout is unverified (T-DTI-1).";
CM_ BO_ 261 "Telemetry 5: temperatures and LV supply.";
CM_ BO_ 262 "Telemetry 6: inverter speed and fault, PT-CAN health counters (spec section 7.4).";
CM_ BO_ 272 "Dashboard feed: speed, state of charge, warnings.";
CM_ SG_ 272 VCU_DashCode "Text/state code index (to be allocated).";
CM_ BO_ 512 "Steering angle sensor node. VCU timeout 100 ms disables the feature that uses it. Never used to raise torque.";
CM_ SG_ 512 SNS_STEER_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 512 SNS_STEER_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 512 SNS_SteerStatus "Sensor status nibble (0 = OK).";
CM_ BO_ 513 "Front damper travel, logger only.";
CM_ BO_ 514 "Rear damper travel, logger only.";
CM_ BO_ 515 "Tyre temperatures, logger only.";
CM_ BO_ 516 "Brake disc temperatures, logger only.";
CM_ BO_ 768 "PDU status. Channel assignment (pump, fans, ...) is defined in the ICD.";
CM_ BO_ 769 "Cooling request. The PDU runs cooling at 100 % if this message is silent for 500 ms (a silent controller must not stop cooling).";
CM_ BO_ 1024 "Time reference for the logger. The logger itself is listen-only and never transmits.";

