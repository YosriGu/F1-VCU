VERSION "svc_0.2_DRAFT"

NS_ :
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	BA_DEF_DEF_

BS_:

BU_: VCU DV SERVICE


BO_ 1280 AS_CMD: 8 DV
 SG_ AS_CMD_CRC : 0|8@1+ (1,0) [0|255] "" VCU
 SG_ AS_CMD_CNT : 8|4@1+ (1,0) [0|15] "" VCU
 SG_ AS_CMD_Mission : 12|4@1+ (1,0) [0|15] "" VCU
 SG_ AS_CMD_TorqueReq_pct : 16|16@1- (0.1,0) [-100|100] "%" VCU
 SG_ AS_CMD_SteerReq_deg : 32|16@1- (0.01,0) [-327|327] "deg" VCU
 SG_ AS_CMD_SpeedReq_kmh : 48|16@1+ (0.01,0) [0|300] "km/h" VCU

BO_ 1281 VCU_AS_STATUS: 8 VCU
 SG_ VCU_AS_CRC : 0|8@1+ (1,0) [0|255] "" DV
 SG_ VCU_AS_CNT : 8|4@1+ (1,0) [0|15] "" DV
 SG_ VCU_AS_State : 16|8@1+ (1,0) [0|255] "" DV
 SG_ VCU_AS_Ready : 24|1@1+ (1,0) [0|1] "" DV
 SG_ VCU_AS_Fault : 25|1@1+ (1,0) [0|1] "" DV
 SG_ VCU_AS_Speed_kmh : 32|16@1+ (0.01,0) [0|300] "km/h" DV

CM_ "SVC-CAN, 500 kbit/s, classic CAN, 11-bit IDs. Driverless messages in 0x500-0x5FF are DRAFT. UDS (0x7E0 range) and XCP use ISO-TP/XCP framing and are not described by a DBC.";
CM_ BO_ 1280 "Driverless command. DRAFT: the driverless rules (T14/T15) were not read. The VCU ignores this message unless autonomous mode is sensed in hardware. Class A, timeout 60 ms = 3 x period, reduce-only relative to the limiter chain.";
CM_ SG_ 1280 AS_CMD_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 1280 AS_CMD_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";
CM_ SG_ 1280 AS_CMD_Mission "Mission ID.";
CM_ SG_ 1280 AS_CMD_TorqueReq_pct "Negative = braking request. Start value 0.";
CM_ BO_ 1281 "VCU status for the driverless computer. DRAFT.";
CM_ SG_ 1281 VCU_AS_CRC "CRC-8/SAE-J1850 over DataId and bytes 1..7 (spec section 5.2)";
CM_ SG_ 1281 VCU_AS_CNT "Rolling counter 0..14; 15 is never valid (spec section 5.1)";

